# このファイルを .env にコピーして、各値を設定してください（.env はコミットしない）。
#   cp .env.example .env
# パスワード・シークレットは辞書に載る単語を避け、ランダムな文字列を使ってください。
#   例（PowerShell）: -join ((1..32) | % { '{0:x}' -f (Get-Random -Max 16) })

# PostgreSQL（docker-compose.yml と application.yml の両方から参照される）
POSTGRES_DB=changeme
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# JWT 署名用シークレット（HS256 のため 32 文字以上）
JWT_SECRET=changeme-at-least-32-characters-long
